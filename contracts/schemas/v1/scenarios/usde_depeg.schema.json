{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.defi-contagion.local/v1/scenarios/usde_depeg.schema.json",
  "title": "Scenario A - USDe market depeg",
  "description": "Blueprint section 7.1.",
  "type": "object",
  "properties": {
    "scenario_id": {
      "const": "usde_depeg"
    },
    "horizon_days": {
      "type": "integer",
      "minimum": 1
    },
    "parameters": {
      "type": "object",
      "properties": {
        "usde_spot_shock_pct": {
          "$ref": "../common.schema.json#/$defs/decimal",
          "description": "Signed move of the USDe market price, e.g. -0.05."
        },
        "susde_market_beta": {
          "$ref": "../common.schema.json#/$defs/decimal",
          "description": "sUSDe market move = beta x USDe move."
        },
        "backing_impairment_pct": {
          "$ref": "../common.schema.json#/$defs/decimal",
          "description": "Permanent backing loss; lowers the sUSDe exchange rate. Signed, 0 = none."
        },
        "oracle_pass_through_override": {
          "$ref": "../common.schema.json#/$defs/nullable_decimal",
          "description": "null = use each market's oracle_pass_through from the snapshot."
        },
        "oracle_lag_hours": {
          "$ref": "../common.schema.json#/$defs/non_negative_decimal",
          "description": "Reported for timing; final metrics use the fully passed-through oracle."
        },
        "pt_pricing_mode": {
          "enum": [
            "implied_apy_discount",
            "amm_quote"
          ]
        },
        "pt_implied_apy_shock": {
          "$ref": "../common.schema.json#/$defs/decimal",
          "description": "Additive change of PT implied APY."
        }
      },
      "required": [
        "usde_spot_shock_pct",
        "susde_market_beta",
        "backing_impairment_pct",
        "oracle_pass_through_override",
        "oracle_lag_hours",
        "pt_pricing_mode",
        "pt_implied_apy_shock"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "scenario_id",
    "horizon_days",
    "parameters"
  ],
  "additionalProperties": false
}
