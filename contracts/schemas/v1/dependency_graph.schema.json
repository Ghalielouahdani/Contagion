{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.defi-contagion.local/v1/dependency_graph.schema.json",
  "title": "Dependency graph",
  "description": "Evidence-backed graph. Owner: P1. Vocabularies (node types, relations, risk channels) live in common.schema.json.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "graph_id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "portfolio_id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "as_of": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "warnings": {
      "$ref": "common.schema.json#/$defs/warnings"
    },
    "chain_id": {
      "$ref": "common.schema.json#/$defs/chain_id"
    },
    "block_number": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Block every on-chain read of a live discovery was pinned to; null for fixtures."
    },
    "coverage": {
      "type": "object",
      "description": "Per position_id: which dependency layers were found, and how firmly. A missing layer is unresolved or not_applicable, never silently absent.",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/position_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/position_coverage"
      }
    },
    "unresolved": {
      "type": "array",
      "description": "Dependencies discovery looked for and could not establish. Absence of data is not absence of risk.",
      "items": {
        "$ref": "#/$defs/unresolved_item"
      }
    },
    "discovery": {
      "type": "object",
      "description": "Run metadata (mode, limits, data sources). Informational."
    }
  },
  "required": [
    "schema_version",
    "graph_id",
    "portfolio_id",
    "as_of",
    "nodes",
    "edges",
    "warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/node_id"
        },
        "type": {
          "$ref": "common.schema.json#/$defs/node_type"
        },
        "label": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "description": "Open bag for adapter-specific facts (address, decimals, ...)."
        }
      },
      "required": [
        "id",
        "type",
        "label"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "method": {
          "$ref": "common.schema.json#/$defs/evidence_method"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/evidence_status"
        },
        "block_number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "call": {
          "type": "string",
          "description": "Contract function, API query or document section that produced the evidence, e.g. PT.SY()."
        },
        "note": {
          "type": "string",
          "description": "Why the edge exists, in one sentence."
        }
      },
      "required": [
        "method",
        "reference",
        "observed_at",
        "status"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^edge:[A-Za-z0-9_.-]+$"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/node_id"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/node_id"
        },
        "relation": {
          "$ref": "common.schema.json#/$defs/relation"
        },
        "risk_channel": {
          "$ref": "common.schema.json#/$defs/risk_channel"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "confidence": {
          "$ref": "common.schema.json#/$defs/confidence"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "relation",
        "risk_channel",
        "evidence",
        "confidence"
      ],
      "additionalProperties": false
    },
    "layer_coverage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "verified",
            "documented",
            "inferred",
            "assumed",
            "unresolved",
            "not_applicable"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/node_id"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_nodes": {
          "type": "array",
          "description": "Related components found off the position's own dependency path (e.g. lending markets accepting a held PT).",
          "items": {
            "$ref": "common.schema.json#/$defs/node_id"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "nodes",
        "edges",
        "note"
      ],
      "additionalProperties": false
    },
    "position_coverage": {
      "type": "object",
      "properties": {
        "layers": {
          "type": "object",
          "properties": {
            "settlement_chain": {
              "$ref": "#/$defs/layer_coverage"
            },
            "yield_source_and_issuer": {
              "$ref": "#/$defs/layer_coverage"
            },
            "oracle": {
              "$ref": "#/$defs/layer_coverage"
            },
            "market_and_liquidity": {
              "$ref": "#/$defs/layer_coverage"
            },
            "lending_collateral_market": {
              "$ref": "#/$defs/layer_coverage"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "layers"
      ],
      "additionalProperties": false
    },
    "unresolved_item": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "position_id": {
          "$ref": "common.schema.json#/$defs/position_id"
        }
      },
      "required": [
        "subject",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
