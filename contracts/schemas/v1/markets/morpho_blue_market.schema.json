{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.defi-contagion.local/v1/markets/morpho_blue_market.schema.json",
  "title": "Morpho Blue market parameters",
  "description": "Parameters of an isolated Morpho market. Liquidatable when LTV > LLTV.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/market_base"
    }
  ],
  "properties": {
    "market_kind": {
      "const": "morpho_blue_market"
    },
    "lltv": {
      "$ref": "../common.schema.json#/$defs/decimal"
    },
    "liquidation_incentive": {
      "$ref": "../common.schema.json#/$defs/decimal"
    },
    "oracle_pass_through": {
      "$ref": "../common.schema.json#/$defs/decimal"
    },
    "oracle_type": {
      "type": "string"
    },
    "oracle_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "collateral_asset": {
      "type": "string",
      "description": "Collateral symbol. Needed for lending_supply positions."
    },
    "loan_asset": {
      "type": "string",
      "description": "Loan asset symbol, e.g. USDC."
    },
    "total_supply_assets": {
      "$ref": "../common.schema.json#/$defs/non_negative_decimal",
      "description": "Market supply in loan-asset units. Needed for lending_supply positions."
    },
    "total_borrow_assets": {
      "$ref": "../common.schema.json#/$defs/non_negative_decimal",
      "description": "Market borrow in loan-asset units. Needed for lending_supply positions."
    },
    "borrower_ltv_buckets": {
      "type": "array",
      "minItems": 1,
      "description": "Borrower debt by current oracle LTV; debt_share values sum to 1. Market aggregates cannot tell how many borrowers a shock liquidates.",
      "items": {
        "type": "object",
        "properties": {
          "ltv": {
            "$ref": "../common.schema.json#/$defs/non_negative_decimal"
          },
          "debt_share": {
            "$ref": "../common.schema.json#/$defs/non_negative_decimal"
          }
        },
        "required": [
          "ltv",
          "debt_share"
        ],
        "additionalProperties": false
      }
    },
    "borrower_distribution_source_type": {
      "$ref": "../common.schema.json#/$defs/source_type",
      "description": "observed = indexed borrower positions; otherwise an assumption."
    }
  },
  "required": [
    "market_kind",
    "lltv",
    "liquidation_incentive",
    "oracle_pass_through",
    "oracle_type"
  ],
  "unevaluatedProperties": false
}
