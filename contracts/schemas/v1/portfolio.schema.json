{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.defi-contagion.local/v1/portfolio.schema.json",
  "title": "Portfolio",
  "description": "Fictional portfolio. Owner: P1. Add a position type: create positions/<type>.schema.json and add it to $defs.position.oneOf.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "portfolio_id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "as_of": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "quote_currency": {
      "const": "USD"
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "gross_value_usd": {
          "$ref": "common.schema.json#/$defs/non_negative_decimal"
        },
        "debt_value_usd": {
          "$ref": "common.schema.json#/$defs/non_negative_decimal"
        },
        "net_equity_usd": {
          "$ref": "common.schema.json#/$defs/decimal"
        }
      },
      "required": [
        "gross_value_usd",
        "debt_value_usd",
        "net_equity_usd"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "portfolio_id",
    "as_of",
    "quote_currency",
    "positions",
    "totals"
  ],
  "additionalProperties": false,
  "$defs": {
    "position": {
      "oneOf": [
        {
          "$ref": "positions/token_holding.schema.json"
        },
        {
          "$ref": "positions/collateralized_borrow.schema.json"
        },
        {
          "$ref": "positions/pt_holding.schema.json"
        }
      ]
    }
  }
}
