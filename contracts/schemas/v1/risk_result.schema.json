{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.defi-contagion.local/v1/risk_result.schema.json",
  "title": "Risk result",
  "description": "Output of the risk engine, one per scenario run. Owner: P2. Add a risk metric: risk_metrics/<type>.schema.json + $defs.risk_metric.oneOf. Add a loss component: just add the key (core four are required).",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "simulation_id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "portfolio_id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "scenario_id": {
      "$ref": "common.schema.json#/$defs/scenario_id"
    },
    "horizon_days": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "const": "USD"
    },
    "positions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position_impact"
      }
    },
    "portfolio": {
      "type": "object",
      "properties": {
        "net_equity_before_usd": {
          "$ref": "common.schema.json#/$defs/decimal"
        },
        "net_equity_after_usd": {
          "$ref": "common.schema.json#/$defs/nullable_decimal"
        },
        "total_conditional_loss_usd": {
          "$ref": "common.schema.json#/$defs/nullable_decimal"
        },
        "shared_liquidity_penalty_usd": {
          "$ref": "common.schema.json#/$defs/non_negative_decimal"
        },
        "aggregation_status": {
          "enum": [
            "complete",
            "pending_all_positions",
            "insufficient_data"
          ]
        }
      },
      "required": [
        "net_equity_before_usd",
        "net_equity_after_usd",
        "total_conditional_loss_usd",
        "shared_liquidity_penalty_usd",
        "aggregation_status"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "model_version": {
          "type": "string"
        },
        "input_snapshot_id": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "input_graph_id": {
          "$ref": "common.schema.json#/$defs/slug"
        }
      },
      "required": [
        "model_version",
        "input_snapshot_id",
        "input_graph_id"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "$ref": "common.schema.json#/$defs/warnings"
    },
    "contagion": {
      "type": "object",
      "description": "Graph-level view: nodes several positions depend on at once. Optional; present when a graph is supplied or explicitly absent.",
      "properties": {
        "graph_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/slug"
            }
          ]
        },
        "hubs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hub"
          }
        },
        "warnings": {
          "$ref": "common.schema.json#/$defs/warnings"
        }
      },
      "required": [
        "graph_id",
        "hubs",
        "warnings"
      ],
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "description": "Optional. Reference runs on the same portfolio and what this scenario adds on top: excess_loss_usd = total_conditional_loss_usd - sum of the runs (null when the total is incomplete).",
      "properties": {
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "run_id": {
                "$ref": "common.schema.json#/$defs/slug"
              },
              "description": {
                "type": "string"
              },
              "total_conditional_loss_usd": {
                "$ref": "common.schema.json#/$defs/decimal"
              }
            },
            "required": [
              "run_id",
              "description",
              "total_conditional_loss_usd"
            ],
            "additionalProperties": false
          }
        },
        "excess_loss_usd": {
          "$ref": "common.schema.json#/$defs/nullable_decimal"
        },
        "excess_meaning": {
          "type": "string"
        }
      },
      "required": [
        "runs",
        "excess_loss_usd",
        "excess_meaning"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "simulation_id",
    "request_id",
    "portfolio_id",
    "scenario_id",
    "horizon_days",
    "currency",
    "positions",
    "portfolio",
    "provenance",
    "warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "risk_metric": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "risk_metrics/health_factor.schema.json"
        },
        {
          "$ref": "risk_metrics/ltv.schema.json"
        }
      ]
    },
    "loss_components": {
      "type": "object",
      "description": "Must sum exactly to conditional_loss_usd. Extra components allowed.",
      "properties": {
        "market_repricing": {
          "$ref": "common.schema.json#/$defs/decimal"
        },
        "backing_impairment": {
          "$ref": "common.schema.json#/$defs/decimal"
        },
        "liquidation_penalty": {
          "$ref": "common.schema.json#/$defs/decimal"
        },
        "execution_haircut": {
          "$ref": "common.schema.json#/$defs/decimal"
        }
      },
      "required": [
        "market_repricing",
        "backing_impairment",
        "liquidation_penalty",
        "execution_haircut"
      ],
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/decimal"
      }
    },
    "position_impact": {
      "type": "object",
      "properties": {
        "position_id": {
          "$ref": "common.schema.json#/$defs/position_id"
        },
        "gross_value_before_usd": {
          "$ref": "common.schema.json#/$defs/non_negative_decimal"
        },
        "gross_value_after_usd": {
          "$ref": "common.schema.json#/$defs/non_negative_decimal"
        },
        "executable_value_after_usd": {
          "$ref": "common.schema.json#/$defs/nullable_decimal"
        },
        "debt_after_usd": {
          "$ref": "common.schema.json#/$defs/non_negative_decimal"
        },
        "net_equity_before_usd": {
          "$ref": "common.schema.json#/$defs/decimal"
        },
        "net_equity_after_usd": {
          "$ref": "common.schema.json#/$defs/decimal"
        },
        "conditional_loss_usd": {
          "$ref": "common.schema.json#/$defs/decimal"
        },
        "loss_components": {
          "$ref": "#/$defs/loss_components"
        },
        "risk_metric": {
          "$ref": "#/$defs/risk_metric"
        },
        "source_type": {
          "$ref": "common.schema.json#/$defs/source_type"
        },
        "field_sources": {
          "$ref": "common.schema.json#/$defs/field_sources"
        },
        "calculation_status": {
          "enum": [
            "illustrative",
            "computed",
            "insufficient_data"
          ]
        },
        "warnings": {
          "$ref": "common.schema.json#/$defs/warnings"
        },
        "contagion": {
          "$ref": "#/$defs/position_contagion"
        }
      },
      "required": [
        "position_id",
        "gross_value_before_usd",
        "gross_value_after_usd",
        "executable_value_after_usd",
        "debt_after_usd",
        "net_equity_before_usd",
        "net_equity_after_usd",
        "conditional_loss_usd",
        "loss_components",
        "risk_metric",
        "source_type",
        "calculation_status",
        "warnings"
      ],
      "additionalProperties": false
    },
    "contagion_path": {
      "type": "object",
      "description": "One dependency path from the position to the node where the shock originates.",
      "properties": {
        "factor": {
          "enum": [
            "usde_price",
            "usde_backing",
            "susde_exchange_rate",
            "pt_implied_yield",
            "exit_liquidity",
            "susde_yield",
            "borrow_rate",
            "node_shock"
          ]
        },
        "root": {
          "$ref": "common.schema.json#/$defs/node_id"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/node_id"
          },
          "minItems": 2
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^edge:"
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/risk_channel"
          }
        },
        "confidence": {
          "$ref": "common.schema.json#/$defs/confidence"
        },
        "unverified_edges": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^edge:"
          }
        }
      },
      "required": [
        "factor",
        "root",
        "nodes",
        "edges",
        "channels",
        "confidence",
        "unverified_edges"
      ],
      "additionalProperties": false
    },
    "position_contagion": {
      "type": "object",
      "description": "How the scenario reaches the position through the dependency graph, cross-checked with valuation.",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contagion_path"
          }
        },
        "evidence_confidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/confidence"
            }
          ]
        },
        "graph_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unmodeled_exposures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "paths",
        "evidence_confidence",
        "graph_gaps",
        "unmodeled_exposures"
      ],
      "additionalProperties": false
    },
    "hub": {
      "type": "object",
      "properties": {
        "node": {
          "$ref": "common.schema.json#/$defs/node_id"
        },
        "label": {
          "type": "string"
        },
        "node_type": {
          "type": "string"
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/position_id"
          },
          "minItems": 2
        },
        "gross_exposure_usd": {
          "$ref": "common.schema.json#/$defs/decimal"
        },
        "net_equity_usd": {
          "$ref": "common.schema.json#/$defs/decimal"
        }
      },
      "required": [
        "node",
        "label",
        "node_type",
        "positions",
        "gross_exposure_usd",
        "net_equity_usd"
      ],
      "additionalProperties": false
    }
  }
}
