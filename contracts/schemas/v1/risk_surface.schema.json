{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.defi-contagion.local/v1/risk_surface.schema.json",
  "title": "Risk surface",
  "description": "Engine results precomputed over a grid of slider values, so the dashboard stays live offline. Owner: P2. Generated by python -m backend.risk.surface.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "surface_id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "portfolio_id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "snapshot_id": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "scenarios": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/scenario_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "required": [
    "schema_version",
    "surface_id",
    "portfolio_id",
    "snapshot_id",
    "scenarios"
  ],
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "common.schema.json#/$defs/decimal"
        },
        "risk_result": {
          "$ref": "risk_result.schema.json"
        },
        "decisions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "decision_result.schema.json"
          }
        }
      },
      "required": [
        "value",
        "risk_result",
        "decisions"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "param": {
          "type": "string"
        },
        "base_request_id": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 1
        }
      },
      "required": [
        "param",
        "base_request_id",
        "points"
      ],
      "additionalProperties": false
    }
  }
}
