{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.defi-contagion.local/v1/positions/token_holding.schema.json",
  "title": "Token holding position",
  "description": "Direct holding of a token (e.g. sUSDe shares).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/position_base"
    }
  ],
  "properties": {
    "position_type": {
      "const": "token_holding"
    },
    "asset_symbol": {
      "type": "string"
    },
    "quantity": {
      "$ref": "../common.schema.json#/$defs/non_negative_decimal"
    },
    "quantity_unit": {
      "type": "string"
    }
  },
  "required": [
    "position_type",
    "asset_symbol",
    "quantity",
    "quantity_unit"
  ],
  "unevaluatedProperties": false
}
