{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.defi-contagion.local/v1/positions/collateralized_borrow.schema.json",
  "title": "Collateralized borrow position",
  "description": "Collateral supplied to a lending market against a debt. Single collateral and single debt asset in v1.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/position_base"
    }
  ],
  "properties": {
    "position_type": {
      "const": "collateralized_borrow"
    },
    "collateral_asset": {
      "type": "string"
    },
    "collateral_quantity": {
      "$ref": "../common.schema.json#/$defs/non_negative_decimal"
    },
    "debt_asset": {
      "type": "string"
    },
    "debt_quantity": {
      "$ref": "../common.schema.json#/$defs/non_negative_decimal"
    }
  },
  "required": [
    "position_type",
    "collateral_asset",
    "collateral_quantity",
    "debt_asset",
    "debt_quantity"
  ],
  "unevaluatedProperties": false
}
