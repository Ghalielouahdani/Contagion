# Backend-only settings. Never use VITE_ variables for API keys.
GEMINI_API_KEY=
RISK_ASSISTANT_MODEL=gemini-3.5-flash-lite

# Optional normalized HTTPS JSON feed, once a news provider is chosen.
# Expected JSON: {"articles": [{"id", "title", "summary", "url", "published_at", "source"}]}
RISK_NEWS_URL=
RISK_NEWS_TOKEN=
